# Copy this file to web/.env.local and fill in your real key (never commit .env.local).
# Get your key from the Perfect Corp / YouCam developer console (yce.perfectcorp.com).
# Only PERFECTCORP_KEY is required — Cloth-v4 V2 auth is a simple Bearer token.
PERFECTCORP_KEY=your_youcam_api_key_here

# Set MOCK=1 to develop UI/flow without spending any render credits.
# MOCK=1

# Optional: for the "See as 3D" feature (image-to-3D). Free tier at tripo3d.ai.
TRIPO_API_KEY=your_tripo3d_key_here
