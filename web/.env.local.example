# Copy this file to web/.env.local. Never commit web/.env.local.

# Hosted Supabase project configuration. The publishable key is designed for
# browser use; database access is still protected by Auth + RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional during local setup. When configured, Turnstile protects anonymous
# session creation and email auth. Its secret key belongs only in Supabase's
# Auth CAPTCHA settings, never in this browser environment file.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Get your key from the Perfect Corp / YouCam developer console (yce.perfectcorp.com).
# Only PERFECTCORP_KEY is required — Cloth-v4 V2 auth is a simple Bearer token.
PERFECTCORP_KEY=your_youcam_api_key_here

# Set MOCK=1 to develop UI/flow without spending any render credits.
# MOCK=1

# Optional but recommended: Gemini Vision for wardrobe categorization and
# candidate reranking/styling explanations. Keep this server-side only.
# Get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash
