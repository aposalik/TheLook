# Copy this file to .env.local and fill in your real values (never commit .env.local).
# Get your key from the Perfect Corp / YouCam developer console (yce.perfectcorp.com).
# Only PERFECTCORP_KEY is required — Cloth-v4 V2 auth is a simple Bearer token.
PERFECTCORP_KEY=your_youcam_api_key_here
# PERFECTCORP_SECRET=optional_not_used_by_v2_bearer_auth
